# ---- Server API ----
PORT=3000
# Folder hasil build frontend. Kosongkan bila web disajikan langsung oleh Nginx.
STATIC_DIR=../frontend/dist
# Isi hanya bila frontend dibuka dari domain berbeda, pisahkan dengan koma
CORS_ORIGINS=

# ---- Koneksi ke VPS database ----
# IP VPS database (sebaiknya IP privat/VPN, jangan buka port 3306 ke publik)
DB_HOST=10.10.0.1
DB_PORT=3306
DB_NAME=kudbantarangin
# Gunakan user khusus dengan hak SELECT + EXECUTE saja (lihat README)
DB_USER=koperasi_api
DB_PASSWORD=ganti_password_ini
DB_POOL=10
# true bila koneksi database memakai SSL
DB_SSL=false

# ---- Login ----
# Isi dengan string acak panjang, mis. hasil: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Peran user ----
# Nama user dari tabel `pass`, pisahkan dengan koma. User lain otomatis "staf".
ROLE_ADMIN=
ROLE_PENGURUS=
